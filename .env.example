# ==============================================================================
# IPO DEALS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# SECURITY ARCHITECTURE RULES:
# 1. Server-side secrets MUST NEVER be prefixed with NEXT_PUBLIC_
# 2. Never commit actual secret keys or .env.local to version control
# 3. All provider keys & database credentials run exclusively server-side
# 4. Never log or output secret keys in application or error logs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL Serverless HTTP)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. INGESTION & CRON AUTHENTICATION (Server-Only Secret)
# ------------------------------------------------------------------------------
CRON_SECRET="your-secure-cron-bearer-secret"

# ------------------------------------------------------------------------------
# 3. EXTERNAL DATA PROVIDERS (Server-Only Secrets)
# ------------------------------------------------------------------------------
IPO_ALERTS_KEY="your-ipo-alerts-api-key"
IPO_GURU_KEY="your-ipo-guru-api-key"
UPSTOX_ANALYTICS_TOKEN="your-upstox-analytics-bearer-token"
GEMINI_API_KEY="your-gemini-ai-api-key"

# ------------------------------------------------------------------------------
# 4. APPLICATION SECURITY & PAN ENCRYPTION (Server-Only Secret)
# ------------------------------------------------------------------------------
# 256-bit AES-GCM encryption key (64-character hex string or 32-byte base64)
PAN_ENCRYPTION_KEY="your-64-character-hex-encryption-key"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
# Google OAuth Client ID (Public identifier)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Google OAuth Client Secret (Server-Only Secret - NEVER expose to client)
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Optional explicit OAuth Redirect URI (Defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google)
GOOGLE_REDIRECT_URI=""

# ------------------------------------------------------------------------------
# 6. PUBLIC APPLICATION CONFIGURATION (Safe for Client Exposure)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="IPO Deals"
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"
