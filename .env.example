# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#
# SECURITY RULES:
# 1. External API keys and secrets MUST NEVER be prefixed with NEXT_PUBLIC_
# 2. Never commit actual secret keys or .env.local to version control
# 3. All provider keys are read exclusively in server-side route handlers / actions
# 4. Never log or output secret keys in application or error logs
# ==============================================================================

# Database Configuration (Neon PostgreSQL Free Tier)
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Background Ingestion & Cron Authentication
CRON_SECRET="your-super-secret-cron-token-placeholder"

# External Data Providers (Server-side ONLY - Evaluated during development)
# Leave empty until provider API access is verified
UPSTOX_API_KEY="your-upstox-api-key-placeholder"
UPSTOX_API_SECRET="your-upstox-api-secret-placeholder"
IPO_GURU_API_KEY="your-ipo-guru-key-placeholder"
IPO_ALERTS_API_KEY="your-ipo-alerts-key-placeholder"

# Public App Metadata (Safe for client exposure)
NEXT_PUBLIC_APP_NAME="Mainboard IPO Tracker"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
